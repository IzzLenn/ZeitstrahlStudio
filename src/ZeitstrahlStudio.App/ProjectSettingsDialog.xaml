<Window x:Class="ZeitstrahlStudio.App.ProjectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeitstrahlStudio.App"
        Title="Projekteinstellungen"
        Width="620"
        Height="650"
        MinWidth="540"
        MinHeight="580"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:HexColorBrushConverter x:Key="HexColorBrushConverter" />
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,13,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,15" Background="{DynamicResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                           FontSize="{StaticResource FontSize2Xl}"
                           FontWeight="SemiBold"
                           Text="Projekteinstellungen" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="Das Farbschema gilt global; Zeitstrahl- und Exportvorgaben werden im Projekt gespeichert." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,14,24,20">
                <TextBlock Style="{StaticResource LabelStyle}" Text="Farbschema" />
                <ComboBox x:Name="ProjectThemeBox"
                          AutomationProperties.Name="Projektweites Farbschema"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="Label" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="Bevorzugte Zeitstrahlansicht" />
                <ComboBox x:Name="ProjectOrientationBox"
                          AutomationProperties.Name="Bevorzugte Zeitstrahlansicht"
                          ItemsSource="{Binding OrientationOptions}"
                          SelectedItem="{Binding SelectedOrientation}"
                          DisplayMemberPath="Label" />

                <CheckBox Margin="0,14,0,0"
                          IsChecked="{Binding CompressLargeGaps}"
                          Content="Große leere Zeitlücken komprimieren" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="Standardfarbe neuer Ereignisse (#RRGGBB)" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DefaultEventColorPreview"
                            Width="34"
                            Height="34"
                            AutomationProperties.Name="Vorschau der Standardereignisfarbe"
                            Background="{Binding DefaultEventColorHex, Converter={StaticResource HexColorBrushConverter}}"
                            BorderBrush="{DynamicResource StrongBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="4" />
                    <TextBox Grid.Column="2"
                             MaxLength="7"
                             AutomationProperties.Name="Standardereignisfarbe als Hexwert"
                             ToolTip="Eigene Standardfarbe im Format #RRGGBB eingeben"
                             Text="{Binding DefaultEventColorHex, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="3"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Eigener Wert: #RRGGBB"
                               TextWrapping="Wrap" />
                </Grid>
                <ListBox x:Name="DefaultEventColorPalette"
                         Margin="0,10,0,0"
                         Padding="0"
                         AutomationProperties.Name="Visuelle Auswahl der Standardereignisfarbe"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding ColorOptions}"
                         SelectedValuePath="Hex"
                         SelectedValue="{Binding SelectedPaletteColorHex, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Margin" Value="0,0,7,7" />
                            <Setter Property="Padding" Value="4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="34"
                                    Height="34"
                                    AutomationProperties.Name="{Binding Label, StringFormat=Standardereignisfarbe {0}}"
                                    Background="{Binding Hex}"
                                    BorderBrush="{DynamicResource StrongBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ToolTip="{Binding Label}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Kartenschrift (8–48 pt)" />
                        <TextBox Text="{Binding TimelineCardFontSize, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Achsenschrift (8–48 pt)" />
                        <TextBox Text="{Binding TimelineAxisFontSize, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource LabelStyle}" Text="Standardschrift für Exporte (8–48 pt)" />
                <TextBox Text="{Binding ExportFontSize, UpdateSourceTrigger=LostFocus}" />

                <Border Margin="0,18,0,0"
                        Padding="11"
                        Background="{DynamicResource DangerLightBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="{DynamicResource DangerTextBrush}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,16,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Die Aufbewahrung automatischer Sicherungen wird im Dialog „Sicherungen“ verwaltet."
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="16,11"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource BaseButtonStyle}"
                        MinWidth="105"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Abbrechen" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="105"
                        Click="Confirm_Click"
                        Content="Übernehmen" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

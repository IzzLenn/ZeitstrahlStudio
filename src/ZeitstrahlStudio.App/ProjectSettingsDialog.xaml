<Window x:Class="ZeitstrahlStudio.App.ProjectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekteinstellungen"
        Width="620"
        Height="650"
        MinWidth="540"
        MinHeight="580"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,13,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="105" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,15" Background="{DynamicResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Projekteinstellungen" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="Darstellung und Exportvorgaben werden im Projekt gespeichert." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,14,24,20">
                <TextBlock Style="{StaticResource LabelStyle}" Text="Farbschema" />
                <ComboBox Height="31"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"
                          DisplayMemberPath="Label" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="Bevorzugte Zeitstrahlansicht" />
                <ComboBox Height="31"
                          ItemsSource="{Binding OrientationOptions}"
                          SelectedItem="{Binding SelectedOrientation}"
                          DisplayMemberPath="Label" />

                <CheckBox Margin="0,14,0,0"
                          IsChecked="{Binding CompressLargeGaps}"
                          Content="Große leere Zeitlücken komprimieren" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="Standardfarbe neuer Ereignisse (#RRGGBB)" />
                <TextBox Height="31"
                         MaxLength="7"
                         Text="{Binding DefaultEventColorHex, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Kartenschrift (8–48 pt)" />
                        <TextBox Height="31"
                                 Text="{Binding TimelineCardFontSize, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Achsenschrift (8–48 pt)" />
                        <TextBox Height="31"
                                 Text="{Binding TimelineAxisFontSize, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource LabelStyle}" Text="Standardschrift für Exporte (8–48 pt)" />
                <TextBox Height="31"
                         Text="{Binding ExportFontSize, UpdateSourceTrigger=LostFocus}" />

                <Border Margin="0,18,0,0"
                        Padding="11"
                        Background="#FEF2F2"
                        BorderBrush="#EF4444"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Foreground="#991B1B"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Margin="0,16,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Die Aufbewahrung automatischer Sicherungen wird im Dialog „Sicherungen“ verwaltet."
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="16,11"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True"
                        Content="Abbrechen" />
                <Button Style="{StaticResource ActionButtonStyle}"
                        Background="{DynamicResource AccentBrush}"
                        BorderBrush="{DynamicResource AccentDarkBrush}"
                        Foreground="{DynamicResource HeaderForegroundBrush}"
                        FontWeight="SemiBold"
                        Click="Confirm_Click"
                        Content="Übernehmen" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

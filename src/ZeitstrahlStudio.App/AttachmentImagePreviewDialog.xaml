<Window x:Class="ZeitstrahlStudio.App.AttachmentImagePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bildvorschau"
        Width="900"
        Height="700"
        MinWidth="560"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ImagePreviewHeader"
                Grid.Row="0"
                Padding="20,14"
                Background="{DynamicResource HeaderBackgroundBrush}"
                AutomationProperties.Name="Bildvorschau: Dateiinformationen">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                           FontSize="{StaticResource FontSize2Xl}"
                           FontWeight="SemiBold"
                           Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="{Binding Dimensions}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="20,16"
                Padding="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CardCornerRadius}">
            <ScrollViewer x:Name="ImagePreviewViewport"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Bildvorschau">
                <Image HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="{Binding PreviewImage}"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Padding="20,12"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button Style="{StaticResource BaseButtonStyle}"
                    Width="100"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="Bildvorschau schließen"
                    Content="Schließen" />
        </Border>
    </Grid>
</Window>

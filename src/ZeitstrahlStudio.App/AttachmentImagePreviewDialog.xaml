<Window x:Class="ZeitstrahlStudio.App.AttachmentImagePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bildvorschau"
        Width="900"
        Height="700"
        MinWidth="560"
        MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#111827">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="16,12" Background="#1E293B">
            <DockPanel>
                <TextBlock Foreground="#FFFFFF"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="{Binding FileName}" />
                <TextBlock Margin="14,3,0,0"
                           Foreground="#94A3B8"
                           Text="{Binding Dimensions}" />
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1"
                      Margin="12"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Image Source="{Binding PreviewImage}"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True" />
        </ScrollViewer>
        <Button Grid.Row="2"
                Width="100"
                Height="32"
                Margin="0,0,16,14"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Content="Schließen" />
    </Grid>
</Window>

<Window x:Class="ZeitstrahlStudio.App.BackupManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lokale Sicherungen"
        Width="1100"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}"
        AutomationProperties.Name="Lokale Projektsicherungen"
        Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,13,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="BackupManagerHeader" Grid.Row="0" Padding="20,14" Background="{DynamicResource HeaderBackgroundBrush}" AutomationProperties.Name="Sicherungsverwaltung: Beschreibung">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                               FontSize="{StaticResource FontSize2Xl}"
                               FontWeight="SemiBold"
                               Text="Lokale Projektsicherungen" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource HeaderMutedBrush}"
                               Text="Manuelle und automatisch rotierende, geprüfte Projektarchive." />
                </StackPanel>
                <TextBlock Margin="24,5,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="20,16"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="BackupRetentionPanel" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Aufbewahrungseinstellungen für Sicherungen">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="Bold"
                                   Text="Aufbewahrung" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Manuelle Sicherungen werden niemals automatisch gelöscht."
                                   TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}"
                                   Text="Sicherungen des aktuellen Tages" />
                        <TextBox Height="30"
                                 ToolTip="Zulässig: 1 bis 48"
                                 AutomationProperties.Name="Anzahl der Sicherungen des aktuellen Tages"
                                 Text="{Binding CurrentDayBackupCount, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource LabelStyle}"
                                   Text="Tägliche Sicherungen" />
                        <TextBox Height="30"
                                 ToolTip="Zulässig: 1 bis 90"
                                 AutomationProperties.Name="Anzahl der täglichen Sicherungen"
                                 Text="{Binding DailyBackupCount, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource LabelStyle}"
                                   Text="Wöchentliche Sicherungen" />
                        <TextBox Height="30"
                                 ToolTip="Zulässig: 1 bis 104"
                                 AutomationProperties.Name="Anzahl der wöchentlichen Sicherungen"
                                 Text="{Binding WeeklyBackupCount, UpdateSourceTrigger=LostFocus}" />

                        <Button Margin="0,18,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplySettingsCommand}"
                                AutomationProperties.Name="Aufbewahrungseinstellungen anwenden"
                                ToolTip="Aufbewahrungsregeln speichern und auf bestehende Sicherungen anwenden"
                                Content="Einstellungen anwenden" />

                        <Border Margin="0,18,0,0"
                                Padding="11"
                                Background="{DynamicResource WarningLightBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <TextBlock Foreground="{DynamicResource WarningTextBrush}"
                                       Text="Vor jeder Wiederherstellung wird automatisch eine manuelle Sicherheitssicherung des aktuellen Stands erstellt."
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="11"
                                Background="{DynamicResource DangerLightBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="Fehler in der Sicherungsverwaltung">
                            <TextBlock Foreground="{DynamicResource DangerTextBrush}"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeLg}"
                               FontWeight="Bold"
                               Text="Verfügbare Sicherungen" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource BaseButtonStyle}"
                            MinWidth="105"
                            Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Sicherungsliste aktualisieren"
                            ToolTip="Lokale Sicherungen erneut laden"
                            Content="Aktualisieren" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="105"
                            Command="{Binding CreateManualBackupCommand}"
                            AutomationProperties.Name="Manuelle Sicherung erstellen"
                            ToolTip="Jetzt eine zusätzliche manuelle Projektsicherung erstellen"
                            Content="Jetzt sichern" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="BackupGrid"
                          ItemsSource="{Binding Backups}"
                          SelectedItem="{Binding SelectedBackup}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                          AutomationProperties.Name="Verfügbare Projektsicherungen">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="190"
                                            Header="Zeitpunkt"
                                            Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" />
                        <DataGridTextColumn Width="130"
                                            Header="Art"
                                            Binding="{Binding TypeDisplay}" />
                        <DataGridTextColumn Width="110"
                                            Header="Größe"
                                            Binding="{Binding FileSizeDisplay}" />
                        <DataGridTextColumn Width="*"
                                            Header="Prüfsumme (SHA-256)"
                                            Binding="{Binding Record.Sha256}" />
                    </DataGrid.Columns>
                </DataGrid>
                    <Border x:Name="BackupEmptyState" Visibility="Collapsed"
                            Padding="24"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            AutomationProperties.Name="Keine lokalen Sicherungen verfügbar">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <TextBlock HorizontalAlignment="Center" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" Text="Noch keine lokale Sicherung" />
                            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Erstellen Sie mit „Jetzt sichern“ eine manuelle Sicherung. Automatische Sicherungen erscheinen nach dem nächsten Speichervorgang."
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Vor der Wiederherstellung wird eine manuelle Sicherheitssicherung erstellt; anschließend bitte speichern." />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="180"
                            Command="{Binding RestoreCommand}"
                            AutomationProperties.Name="Ausgewählte Sicherung wiederherstellen"
                            ToolTip="Ausgewählte Sicherung nach Bestätigung wiederherstellen"
                            Content="Auswahl wiederherstellen" />
                </DockPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,11"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button Style="{StaticResource BaseButtonStyle}"
                    Width="105"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    AutomationProperties.Name="Sicherungsverwaltung schließen"
                    ToolTip="Sicherungsverwaltung schließen"
                    Content="Schließen" />
        </Border>

        <Border Grid.RowSpan="3"
                Background="{DynamicResource DialogOverlayBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.Name="Sicherungsvorgang wird ausgeführt">
            <StackPanel Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Height="7" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="{DynamicResource HeaderForegroundBrush}"
                           TextAlignment="Center"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

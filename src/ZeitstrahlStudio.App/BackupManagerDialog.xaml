<Window x:Class="ZeitstrahlStudio.App.BackupManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lokale Sicherungen"
        Width="1100"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="105" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource RaisedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource HeaderForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,13,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource HeaderBackgroundBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="Lokale Projektsicherungen" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource HeaderMutedBrush}"
                               Text="Manuelle und automatisch rotierende, geprüfte Projektarchive." />
                </StackPanel>
                <TextBlock Margin="24,5,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="20,16"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Text="Aufbewahrung" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Manuelle Sicherungen werden niemals automatisch gelöscht."
                                   TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelStyle}"
                                   Text="Sicherungen des aktuellen Tages" />
                        <TextBox Height="30"
                                 ToolTip="Zulässig: 1 bis 48"
                                 Text="{Binding CurrentDayBackupCount, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource LabelStyle}"
                                   Text="Tägliche Sicherungen" />
                        <TextBox Height="30"
                                 ToolTip="Zulässig: 1 bis 90"
                                 Text="{Binding DailyBackupCount, UpdateSourceTrigger=LostFocus}" />

                        <TextBlock Style="{StaticResource LabelStyle}"
                                   Text="Wöchentliche Sicherungen" />
                        <TextBox Height="30"
                                 ToolTip="Zulässig: 1 bis 104"
                                 Text="{Binding WeeklyBackupCount, UpdateSourceTrigger=LostFocus}" />

                        <Button Margin="0,18,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplySettingsCommand}"
                                Content="Einstellungen anwenden" />

                        <Border Margin="0,18,0,0"
                                Padding="11"
                                Background="#FFFBEB"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock Foreground="#92400E"
                                       Text="Vor jeder Wiederherstellung wird automatisch eine manuelle Sicherheitssicherung des aktuellen Stands erstellt."
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="11"
                                Background="#FEF2F2"
                                BorderBrush="#EF4444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#991B1B"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="Verfügbare Sicherungen" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Aktualisieren" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateManualBackupCommand}"
                            Content="Jetzt sichern" />
                </DockPanel>

                <DataGrid x:Name="BackupGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Backups}"
                          SelectedItem="{Binding SelectedBackup}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="{DynamicResource SurfaceAltBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="190"
                                            Header="Zeitpunkt"
                                            Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" />
                        <DataGridTextColumn Width="130"
                                            Header="Art"
                                            Binding="{Binding TypeDisplay}" />
                        <DataGridTextColumn Width="110"
                                            Header="Größe"
                                            Binding="{Binding FileSizeDisplay}" />
                        <DataGridTextColumn Width="*"
                                            Header="Prüfsumme (SHA-256)"
                                            Binding="{Binding Record.Sha256}" />
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="Die Wiederherstellung ersetzt nicht sofort die gespeicherte Projektdatei." />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RestoreCommand}"
                            Content="Auswahl wiederherstellen" />
                </DockPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,11"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button Width="105"
                    Height="34"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Content="Schließen" />
        </Border>

        <Border Grid.RowSpan="3"
                Background="#990F172A"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Height="7" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,0"
                           Foreground="{DynamicResource HeaderForegroundBrush}"
                           TextAlignment="Center"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="ZeitstrahlStudio.App.PdfExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF-Exportvorschau"
        Width="1280"
        Height="860"
        MinWidth="980"
        MinHeight="640"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource HeaderBackgroundBrush}"
                AutomationProperties.Name="PDF-Export: Beschreibung">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                               FontSize="{StaticResource FontSize2Xl}"
                               FontWeight="SemiBold"
                               Text="PDF-Exportvorschau" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource HeaderMutedBrush}"
                               Text="Die Vorschau zeigt die tatsächlich erzeugte lokale PDF-Datei." />
                </StackPanel>
                <TextBlock Margin="20,5,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="PDF-Exportoptionen">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="Bold"
                                   Text="Druckeinstellungen" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Papierformat" />
                        <ComboBox ItemsSource="{Binding PaperSizes}"
                                  SelectedItem="{Binding SelectedPaperSize}" />

                        <CheckBox Margin="0,9,0,0"
                                  IsChecked="{Binding Landscape}"
                                  Content="Querformat" />

                        <Grid Margin="0,4,0,0"
                              Visibility="{Binding IsCustomPaper, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Breite (mm)" />
                                <TextBox Text="{Binding WidthMillimeters, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Höhe (mm)" />
                                <TextBox Text="{Binding HeightMillimeters, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Exportmodus" />
                        <ComboBox ItemsSource="{Binding Modes}"
                                  SelectedItem="{Binding SelectedMode}"
                                  DisplayMemberPath="DisplayName" />

                        <StackPanel Visibility="{Binding IsRangeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Zeitraum von" />
                            <DatePicker SelectedDate="{Binding RangeStart}" />
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Zeitraum bis" />
                            <DatePicker SelectedDate="{Binding RangeEnd}" />
                            <CheckBox Margin="0,9,0,0"
                                      IsChecked="{Binding IncludeOverlappingRanges}"
                                      Content="Überschneidende Zeiträume einschließen"
                                      ToolTip="Nimmt Ereignisse auf, deren Zeitraum den gewählten Bereich überschneidet." />
                        </StackPanel>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Exportschriftgröße (pt)" />
                        <TextBox Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" />

                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding IncludeNotes}"
                                  Content="Interne Notizen ausgeben" />

                        <Button Margin="0,16,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RefreshPreviewCommand}"
                                Content="Vorschau aktualisieren" />

                        <Border Margin="0,14,0,0"
                                Padding="10"
                                Background="{DynamicResource WarningLightBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource WarningTextBrush}"
                                       Text="{Binding WarningsText}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="10"
                                Background="{DynamicResource DangerLightBrush}"
                                BorderBrush="{DynamicResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{DynamicResource DangerTextBrush}"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="14,10"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PdfExportPreviewTools" Orientation="Horizontal" AutomationProperties.Name="PDF-Exportvorschau Werkzeuge">
                            <Button MinWidth="112"
                                    Margin="0,0,8,0"
                                    Command="{Binding Preview.PreviousPageCommand}"
                                    AutomationProperties.Name="Vorherige PDF-Exportseite"
                                    Content="Vorherige Seite" />
                            <TextBlock Width="130"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyStyle}"
                                       TextAlignment="Center"
                                       Text="{Binding Preview.PageDisplay}" />
                            <Button MinWidth="108"
                                    Margin="0,0,8,0"
                                    Command="{Binding Preview.NextPageCommand}"
                                    AutomationProperties.Name="Nächste PDF-Exportseite"
                                    Content="Nächste Seite" />
                            <Button MinWidth="104"
                                    Margin="0,0,8,0"
                                    Command="{Binding Preview.ZoomOutCommand}"
                                    AutomationProperties.Name="PDF-Exportvorschau verkleinern"
                                    Content="Verkleinern" />
                            <TextBlock Width="90"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyStyle}"
                                       TextAlignment="Center"
                                       Text="{Binding Preview.ZoomDisplay}" />
                            <Button MinWidth="100"
                                    Margin="0,0,8,0"
                                    Command="{Binding Preview.ZoomInCommand}"
                                    AutomationProperties.Name="PDF-Exportvorschau vergrößern"
                                    Content="Vergrößern" />
                            <Button MinWidth="90"
                                    Margin="0,0,8,0"
                                    Command="{Binding Preview.FitWidthCommand}"
                                    Content="Fensterbreite" />
                            <Button MinWidth="90"
                                    Margin="0,0,8,0"
                                    Command="{Binding Preview.ShowWholePageCommand}"
                                    Content="Ganze Seite" />
                            <Button MinWidth="100"
                                    Margin="0,0,8,0"
                                    Command="{Binding Preview.OpenExternallyCommand}"
                                    Content="Extern prüfen" />
                        </WrapPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" Margin="16">
                    <ScrollViewer x:Name="PreviewViewport"
                                  AutomationProperties.Name="PDF-Exportseitenvorschau"
                                  Padding="16"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SizeChanged="PreviewViewport_OnSizeChanged">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Padding="1"
                                Background="{DynamicResource RaisedSurfaceBrush}"
                                BorderBrush="{DynamicResource StrongBorderBrush}"
                                BorderThickness="1">
                            <Image Width="{Binding Preview.PreviewWidth}"
                                   Height="{Binding Preview.PreviewHeight}"
                                   Source="{Binding Preview.PreviewImage}"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True" />
                        </Border>
                    </ScrollViewer>

                    <Border Background="{DynamicResource DialogOverlayBrush}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Width="320"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ProgressBar Height="7" IsIndeterminate="True" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{DynamicResource OnAccentTextBrush}"
                                       TextAlignment="Center"
                                       Text="{Binding StatusMessage}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding PageSummary}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            IsCancel="True"
                            AutomationProperties.Name="PDF-Export abbrechen"
                            Content="Abbrechen" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExportCommand}"
                            AutomationProperties.Name="PDF exportieren"
                            Content="PDF exportieren" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

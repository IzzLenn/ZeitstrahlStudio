<Window x:Class="ZeitstrahlStudio.App.PdfExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF-Exportvorschau"
        Width="1280"
        Height="860"
        MinWidth="980"
        MinHeight="640"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#E2E8F0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,13" Background="#0F172A">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Foreground="#FFFFFF"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="PDF-Exportvorschau" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#94A3B8"
                               Text="Die Vorschau zeigt die tatsächlich erzeugte lokale PDF-Datei." />
                </StackPanel>
                <TextBlock Margin="20,5,0,0"
                           HorizontalAlignment="Right"
                           Foreground="#CBD5E1"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="18,14"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Foreground="#0F172A"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Text="Druckeinstellungen" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Papierformat" />
                        <ComboBox ItemsSource="{Binding PaperSizes}"
                                  SelectedItem="{Binding SelectedPaperSize}"
                                  Height="30" />

                        <CheckBox Margin="0,9,0,0"
                                  IsChecked="{Binding Landscape}"
                                  Content="Querformat" />

                        <Grid Margin="0,4,0,0"
                              Visibility="{Binding IsCustomPaper, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Breite (mm)" />
                                <TextBox Height="28"
                                         Text="{Binding WidthMillimeters, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Höhe (mm)" />
                                <TextBox Height="28"
                                         Text="{Binding HeightMillimeters, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Exportmodus" />
                        <ComboBox ItemsSource="{Binding Modes}"
                                  SelectedItem="{Binding SelectedMode}"
                                  DisplayMemberPath="DisplayName"
                                  Height="30" />

                        <StackPanel Visibility="{Binding IsRangeMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Zeitraum von" />
                            <DatePicker SelectedDate="{Binding RangeStart}" />
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Zeitraum bis" />
                            <DatePicker SelectedDate="{Binding RangeEnd}" />
                            <CheckBox Margin="0,9,0,0"
                                      IsChecked="{Binding IncludeOverlappingRanges}"
                                      Content="Überschneidende Zeiträume einschließen"
                                      ToolTip="Nimmt Ereignisse auf, deren Zeitraum den gewählten Bereich überschneidet." />
                        </StackPanel>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Exportschriftgröße (pt)" />
                        <TextBox Height="28"
                                 Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" />

                        <CheckBox Margin="0,10,0,0"
                                  IsChecked="{Binding IncludeNotes}"
                                  Content="Interne Notizen ausgeben" />

                        <Button Margin="0,16,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RefreshPreviewCommand}"
                                Content="Vorschau aktualisieren" />

                        <Border Margin="0,14,0,0"
                                Padding="10"
                                Background="#FFFBEB"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#92400E"
                                       Text="{Binding WarningsText}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Border Margin="0,14,0,0"
                                Padding="10"
                                Background="#FEF2F2"
                                BorderBrush="#EF4444"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="#991B1B"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Background="#111827">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="12,9"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding Preview.PreviousPageCommand}"
                                    Content="◀" />
                            <TextBlock Width="130"
                                       VerticalAlignment="Center"
                                       Foreground="#E2E8F0"
                                       TextAlignment="Center"
                                       Text="{Binding Preview.PageDisplay}" />
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding Preview.NextPageCommand}"
                                    Content="▶" />
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding Preview.ZoomOutCommand}"
                                    Content="−" />
                            <TextBlock Width="90"
                                       VerticalAlignment="Center"
                                       Foreground="#E2E8F0"
                                       TextAlignment="Center"
                                       Text="{Binding Preview.ZoomDisplay}" />
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding Preview.ZoomInCommand}"
                                    Content="+" />
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding Preview.FitWidthCommand}"
                                    Content="Fensterbreite" />
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding Preview.ShowWholePageCommand}"
                                    Content="Ganze Seite" />
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding Preview.OpenExternallyCommand}"
                                    Content="Extern prüfen" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="1" Margin="12">
                    <ScrollViewer x:Name="PreviewViewport"
                                  Padding="16"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SizeChanged="PreviewViewport_OnSizeChanged">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Padding="1"
                                Background="#FFFFFF"
                                BorderBrush="#64748B"
                                BorderThickness="1">
                            <Image Width="{Binding Preview.PreviewWidth}"
                                   Height="{Binding Preview.PreviewHeight}"
                                   Source="{Binding Preview.PreviewImage}"
                                   Stretch="Fill"
                                   SnapsToDevicePixels="True" />
                        </Border>
                    </ScrollViewer>

                    <Border Background="#990F172A"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Width="320"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ProgressBar Height="7" IsIndeterminate="True" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="#FFFFFF"
                                       TextAlignment="Center"
                                       Text="{Binding StatusMessage}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="14,10" Background="#E2E8F0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#475569"
                           Text="{Binding PageSummary}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButtonStyle}"
                            IsCancel="True"
                            Content="Abbrechen" />
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ExportCommand}"
                            Content="PDF speichern" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="ZeitstrahlStudio.App.AttachmentPdfPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF-Vorschau"
        Width="1100"
        Height="820"
        MinWidth="720"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource HeaderBackgroundBrush}"
                AutomationProperties.Name="PDF-Vorschau: Dateiinformationen">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Foreground="{DynamicResource HeaderForegroundBrush}"
                           FontSize="{StaticResource FontSize2Xl}"
                           FontWeight="SemiBold"
                           Text="{Binding FileName}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="18,3,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="14,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="PdfPreviewTools" Orientation="Horizontal" AutomationProperties.Name="PDF-Vorschau Werkzeuge">
                    <Button MinWidth="112"
                            Margin="0,0,8,0"
                            Command="{Binding PreviousPageCommand}"
                            AutomationProperties.Name="Vorherige PDF-Seite"
                            Content="Vorherige Seite" />
                    <TextBlock Width="130"
                               Margin="4,0,10,0"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource BodyStyle}"
                               FontWeight="SemiBold"
                               Text="{Binding PageDisplay}" />
                    <Button MinWidth="108"
                            Margin="0,0,8,0"
                            Command="{Binding NextPageCommand}"
                            AutomationProperties.Name="Nächste PDF-Seite"
                            Content="Nächste Seite" />
                    <Border Width="1" Margin="4,2,12,2" Background="{DynamicResource DividerBrush}" />
                    <Button MinWidth="104"
                            Margin="0,0,8,0"
                            Command="{Binding ZoomOutCommand}"
                            AutomationProperties.Name="PDF-Vorschau verkleinern"
                            Content="Verkleinern" />
                    <TextBlock Width="90"
                               Margin="2,0,8,0"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource BodyStyle}"
                               Text="{Binding ZoomDisplay}" />
                    <Button MinWidth="100"
                            Margin="0,0,8,0"
                            Command="{Binding ZoomInCommand}"
                            AutomationProperties.Name="PDF-Vorschau vergrößern"
                            Content="Vergrößern" />
                    <Button MinWidth="90"
                            Margin="0,0,8,0"
                            Command="{Binding FitWidthCommand}"
                            Content="Fensterbreite" />
                    <Button MinWidth="90"
                            Margin="0,0,8,0"
                            Command="{Binding ShowWholePageCommand}"
                            Content="Ganze Seite" />
                    <Border Width="1" Margin="4,2,12,2" Background="{DynamicResource DividerBrush}" />
                    <Button MinWidth="110"
                            Margin="0,0,8,0"
                            Command="{Binding OpenExternallyCommand}"
                            Content="In Windows öffnen" />
                </WrapPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="20,16">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <ScrollViewer x:Name="PreviewViewport"
                              AutomationProperties.Name="PDF-Seitenvorschau"
                              Padding="16"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="PreviewViewport_OnSizeChanged">
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Padding="1"
                            Background="{DynamicResource RaisedSurfaceBrush}"
                            BorderBrush="{DynamicResource StrongBorderBrush}"
                            BorderThickness="1">
                        <Image Width="{Binding PreviewWidth}"
                               Height="{Binding PreviewHeight}"
                               Source="{Binding PreviewImage}"
                               Stretch="Fill"
                               SnapsToDevicePixels="True" />
                    </Border>
                </ScrollViewer>
            </Border>

            <Border MaxWidth="620"
                    Margin="24"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource DangerLightBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource DangerTextBrush}"
                               FontSize="{StaticResource FontSizeXl}"
                               FontWeight="SemiBold"
                               Text="PDF-Vorschau nicht verfügbar" />
                    <TextBlock Margin="0,9,0,0"
                               Style="{StaticResource BodyStyle}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource DialogOverlayBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Width="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar Height="6" IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource BodyStyle}"
                               Foreground="{DynamicResource OnAccentTextBrush}"
                               TextAlignment="Center"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="20,12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource BodyStyle}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding DimensionsText}" />
                <Button Width="100"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        IsCancel="True"
                        AutomationProperties.Name="PDF-Vorschau schließen"
                        Content="Schließen" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

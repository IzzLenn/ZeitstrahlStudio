<Window x:Class="ZeitstrahlStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeitstrahlStudio.App"
        Title="Zeitstrahl Studio"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        AutomationProperties.Name="Zeitstrahl Studio Hauptfenster"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.CreateContextCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteSelectionCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelAttachmentImportCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            </Style>

            <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="MinWidth" Value="72" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            </Style>

            <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="4,4,10,4" />
                <Setter Property="Background" Value="{DynamicResource ToolbarSeparatorBrush}" />
            </Style>

            <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            </Style>

            <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Content" Value="☰" />
                <Setter Property="ToolTip" Value="Seitenleiste ein-/ausblenden" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hauptnavigation -->
        <Border Grid.Row="0"
                Padding="14,10"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="SidebarToggleButton"
                            Style="{StaticResource SidebarToggleButtonStyle}"
                            Click="SidebarToggle_Click"
                            AutomationProperties.Name="Seitenleiste umschalten" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                                   FontSize="{StaticResource FontSize2Xl}"
                                   FontWeight="Bold"
                                   Text="Zeitstrahl Studio" />
                        <TextBlock Foreground="{DynamicResource HeaderMutedBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   Text="Lokale Projektchroniken" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SettingsCommand}"
                            ToolTip="Projekteinstellungen"
                            Content="Einstellungen" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ManageBackupsCommand}"
                            ToolTip="Lokale Sicherungen verwalten"
                            Content="Sicherungen" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ShowAuditLogCommand}"
                            ToolTip="Änderungsprotokoll anzeigen"
                            Content="Protokoll" />
                </StackPanel>

                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarPrimaryButtonStyle}"
                            Command="{Binding NewProjectCommand}"
                            ToolTip="Neues Projekt (Strg+N)"
                            Content="Neu" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenProjectCommand}"
                            Content="Öffnen" />
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SaveCommand}"
                            ToolTip="Projekt speichern (Strg+S)"
                            Content="Speichern" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SaveAsCommand}"
                            Content="Speichern unter" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding DuplicateCommand}"
                            Content="Duplizieren" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CloseProjectCommand}"
                            Content="Schließen" />
                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding UndoCommand}"
                            ToolTip="Rückgängig (Strg+Z)"
                            Content="Rückgängig" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding RedoCommand}"
                            ToolTip="Wiederholen (Strg+Y)"
                            Content="Wiederholen" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="SearchFocus_Click"
                            ToolTip="Suche fokussieren (Strg+F)"
                            Content="Suchen" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Hauptbereich -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="320" MinWidth="260" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Linke Seitenleiste -->
            <Border Grid.Column="0"
                    Padding="16"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="AKTUELLES PROJEKT" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="{StaticResource FontSize2Xl}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{Binding ProjectName}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ProjectDescription}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   Text="{Binding ProjectArchivePath}"
                                   TextWrapping="Wrap" />

                        <Expander x:Name="SearchExpander"
                                  Margin="0,22,0,0"
                                  IsExpanded="True"
                                  IsEnabled="{Binding HasProject}">
                            <Expander.Header>
                                <DockPanel Width="270">
                                    <TextBlock DockPanel.Dock="Left"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               FontWeight="Bold"
                                               Text="SUCHE UND FILTER" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Text="{Binding ActiveFilterText}" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <TextBox x:Name="SearchQueryTextBox"
                                         Padding="8,6"
                                         AutomationProperties.Name="Volltextsuche"
                                         ToolTip="Projektdaten, Ereignisse, Dateinamen, Links und extrahierte Dokumenttexte durchsuchen"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0"
                                                AutomationProperties.Name="Suchzeitraum von"
                                                ToolTip="Zeitraum ab"
                                                SelectedDate="{Binding SearchFrom, UpdateSourceTrigger=PropertyChanged}" />
                                    <DatePicker Grid.Column="2"
                                                AutomationProperties.Name="Suchzeitraum bis"
                                                ToolTip="Zeitraum bis"
                                                SelectedDate="{Binding SearchUntil, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <ComboBox Margin="0,7,0,0"
                                          AutomationProperties.Name="Datumsart filtern"
                                          ItemsSource="{Binding SearchPrecisionOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SearchPrecision}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              AutomationProperties.Name="Nach vorhandener Frist filtern"
                                              ItemsSource="{Binding SearchDeadlinePresenceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchHasDeadline}" />
                                    <ComboBox Grid.Column="2"
                                              AutomationProperties.Name="Nach Friststatus filtern"
                                              ItemsSource="{Binding SearchDeadlineStatusOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchDeadlineStatus}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              AutomationProperties.Name="Nach Priorität filtern"
                                              ItemsSource="{Binding SearchPriorityOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchPriority}" />
                                    <ComboBox Grid.Column="2"
                                              AutomationProperties.Name="Nach Farbe filtern"
                                              ItemsSource="{Binding SearchColorOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchColor}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              AutomationProperties.Name="Nach Schlagwort filtern"
                                              ItemsSource="{Binding SearchTagOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchTag}" />
                                    <ComboBox Grid.Column="2"
                                              AutomationProperties.Name="Nach Dateityp filtern"
                                              ItemsSource="{Binding SearchMediaTypeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchMediaType}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              AutomationProperties.Name="Nach vorhandenen Anhängen filtern"
                                              ItemsSource="{Binding SearchAttachmentPresenceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchHasAttachment}" />
                                    <ComboBox Grid.Column="2"
                                              AutomationProperties.Name="Nach vorhandenen PDF-Dateien filtern"
                                              ItemsSource="{Binding SearchPdfPresenceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchHasPdf}" />
                                </Grid>
                                <DockPanel Margin="0,8,0,6">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding ResetSearchFiltersCommand}"
                                            Content="Alle zurücksetzen" />
                                    <ComboBox Width="105"
                                              DockPanel.Dock="Left"
                                              AutomationProperties.Name="Suchergebnisse sortieren"
                                              ItemsSource="{Binding SearchSortOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchSortMode}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               Text="{Binding SearchSummaryText}" />
                                </DockPanel>
                                <ListBox Height="330"
                                         AutomationProperties.Name="Suchergebnisse"
                                         ItemsSource="{Binding SearchResults}"
                                         Background="{DynamicResource RaisedSurfaceBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Padding="9"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   Text="{Binding Date}" />
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   Text="{Binding EventTitle}"
                                                                   TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Highlights}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <local:HighlightedTextBlock Margin="0,2,0,0"
                                                                                            Foreground="{DynamicResource SubtleTextBrush}"
                                                                                            FontSize="{StaticResource FontSizeXs}"
                                                                                            HighlightedText="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <Grid Margin="0,28,0,10">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       FontWeight="Bold"
                                       Text="ZULETZT VERWENDET" />
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    Content="Aktualisieren" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="11"
                                            Background="{DynamicResource RaisedSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource CardCornerRadius}">
                                        <StackPanel>
                                            <Button Style="{StaticResource LinkButtonStyle}"
                                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding ArchivePath}"
                                                    Content="{Binding ProjectName}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       Text="{Binding LastOpenedAtUtc, StringFormat='Zuletzt geöffnet: {0:g}'}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,22,0,0">
                            <TextBlock Margin="0,0,0,10"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       FontWeight="Bold"
                                       Text="WIEDERHERSTELLUNG" />
                            <ItemsControl ItemsSource="{Binding RecoveryCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="11"
                                                Background="{DynamicResource WarningLightBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource CardCornerRadius}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Text="{Binding ProjectName}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,8"
                                                           Foreground="{DynamicResource WarningTextBrush}"
                                                           FontSize="{StaticResource FontSizeXs}"
                                                           Text="Nicht ordnungsgemäß geschlossen" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,12,0"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Command="{Binding DataContext.RecoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Wiederherstellen" />
                                                    <Button Style="{StaticResource LinkButtonStyle}"
                                                            Foreground="{DynamicResource DangerTextBrush}"
                                                            Command="{Binding DataContext.DiscardRecoveryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Verwerfen" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False" />

            <!-- Hauptarbeitsbereich -->
            <Grid Grid.Column="2" Background="{DynamicResource RaisedSurfaceBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="36">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="30"
                                   FontWeight="Light"
                                   Text="＋" />
                    </Border>
                    <TextBlock Margin="0,22,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSize4Xl}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Eine Chronik beginnen" />
                    <TextBlock Width="470"
                               Margin="0,8,0,20"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Erstellen Sie ein lokales Projekt oder öffnen Sie ein vorhandenes .zeitprojekt-Archiv." />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NewProjectCommand}"
                                Content="Neues Projekt" />
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding OpenProjectCommand}"
                                Content="Projekt öffnen" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="24,20"
                      Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="{StaticResource FontSize3Xl}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding ProjectName}" />
                    <DockPanel Grid.Row="1" Margin="0,9,0,18" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0,0,18,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Chronologische Ereignisübersicht" />
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding EventCount, StringFormat={}{0} Ereignisse}" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding DeleteEventCommand}"
                                ToolTip="Ausgewähltes Ereignis löschen (Entf)"
                                Content="Löschen" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding EditEventCommand}"
                                Content="Bearbeiten" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding MoveEventLaterCommand}"
                                ToolTip="Nur innerhalb identischer Datumsangaben"
                                Content="Später" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding MoveEventEarlierCommand}"
                                ToolTip="Nur innerhalb identischer Datumsangaben"
                                Content="Früher" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarPrimaryButtonStyle}"
                                Command="{Binding AddEventCommand}"
                                ToolTip="Neues Ereignis anlegen (Strg+N)"
                                Content="Hinzufügen" />
                    </DockPanel>
                    <TabControl Grid.Row="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                        <TabItem Header="Zeitstrahl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="9"
                                        Background="{DynamicResource RaisedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="False">
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding SetHorizontalTimelineCommand}"
                                                Content="Horizontal" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding SetVerticalTimelineCommand}"
                                                Content="Vertikal" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ToggleGapCompressionCommand}"
                                                ToolTip="Große leere Zeiträume komprimieren oder vollständig darstellen"
                                                Content="{Binding GapCompressionText}" />
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineZoomOut_Click"
                                                ToolTip="Herauszoomen (Tastatur: Minus)"
                                                Content="−" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineZoomIn_Click"
                                                ToolTip="Hineinzoomen (Tastatur: Plus)"
                                                Content="+" />
                                        <TextBlock DockPanel.Dock="Left"
                                                   Width="58"
                                                   Margin="2,0,8,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="{Binding TimelineZoomText}" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineShowAll_Click"
                                                ToolTip="Gesamtes Projekt auf die Zeitachse einpassen"
                                                Content="Alles" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineCenterSelection_Click"
                                                ToolTip="Ausgewähltes Ereignis zentrieren"
                                                Content="Auswahl" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineResetView_Click"
                                                ToolTip="Zoom und sichtbaren Bereich zurücksetzen"
                                                Content="Zurücksetzen" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ResetTimelineLayoutCommand}"
                                                ToolTip="Alle manuellen Kartenpositionen entfernen und die automatische Anordnung wiederherstellen"
                                                Content="Auto-Layout" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Text="Mausrad: Zoom · Hintergrund ziehen: Verschieben" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1"
                                        Padding="9,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="Zeitraum anzeigen:" />
                                        <DatePicker Width="125"
                                                    AutomationProperties.Name="Anzuzeigender Zeitraum von"
                                                    SelectedDate="{Binding TimelineRangeStart, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="bis" />
                                        <DatePicker Width="125"
                                                    AutomationProperties.Name="Anzuzeigender Zeitraum bis"
                                                    SelectedDate="{Binding TimelineRangeEnd, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="9,0,0,0"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ShowTimelineRangeCommand}"
                                                ToolTip="Den gewählten fachlichen Zeitraum in den sichtbaren Ausschnitt einpassen"
                                                Content="Anzeigen" />
                                        <TextBlock Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Text="Karte ziehen: nur Layout ändern · Datum bleibt unverändert" />
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="2"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True"
                                              Focusable="False">
                                    <local:TimelineView x:Name="TimelineControl"
                                                        AutomationProperties.Name="Interaktiver Zeitstrahl"
                                                        AutomationProperties.HelpText="Mit Plus und Minus zoomen, mit Pos1 das ganze Projekt anzeigen und Ereigniskarten mit den Pfeiltasten auswählen."
                                                        Project="{Binding CurrentProject}"
                                                        Workspace="{Binding ActiveWorkspace}"
                                                        ThumbnailService="{Binding TimelineThumbnailService}"
                                                        SelectedEvent="{Binding SelectedEvent, Mode=TwoWay}"
                                                        Orientation="{Binding TimelineViewOrientation}"
                                                        ZoomFactor="{Binding TimelineZoom, Mode=TwoWay}"
                                                        CompressLargeGaps="{Binding CompressLargeGaps}"
                                                        LayoutRevision="{Binding TimelineLayoutRevision}"
                                                        CardFontSize="{Binding TimelineCardFontSize}"
                                                        AxisFontSize="{Binding TimelineAxisFontSize}"
                                                        IsDarkTheme="{Binding IsDarkTheme}"
                                                        MoveCardCommand="{Binding MoveTimelineCardCommand}"
                                                        DropFilesCommand="{Binding ImportDroppedFilesCommand}"
                                                        RangeRequest="{Binding TimelineRangeRequest}"
                                                        VisibleEventIds="{Binding TimelineVisibleEventIds}"
                                                        CenterSelectionRevision="{Binding TimelineSelectionNavigationRevision}"
                                                        ToolTip="Ereigniskarte auswählen oder rein visuell ziehen; Hintergrund ziehen; Mausrad zoomt" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Ereignisliste">
                            <Grid Background="{DynamicResource SurfaceBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="310" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="{DynamicResource CardCornerRadius}">
                                    <ListBox x:Name="EventList"
                                             Margin="12"
                                             AutomationProperties.Name="Chronologische Ereignisliste"
                                             ItemsSource="{Binding Events}"
                                             SelectedItem="{Binding SelectedEvent}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="EventList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="EventList_PreviewMouseMove"
                                             DragOver="EventList_DragOver"
                                             DragLeave="EventList_DragLeave"
                                             Drop="EventList_Drop"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ToolTip="Ereignis innerhalb derselben Datumsgruppe ziehen; Dateien auf das gewünschte Ereignis ablegen">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="8" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <Trigger Property="Tag" Value="Before">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,3,0,0" />
                                                    </Trigger>
                                                    <Trigger Property="Tag" Value="After">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,3" />
                                                    </Trigger>
                                                    <Trigger Property="Tag" Value="DropFiles">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Top"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               FontSize="{StaticResource FontSizeLg}"
                                                               FontWeight="Bold"
                                                               Text="{Binding Date}" />
                                                    <Border Grid.Column="1"
                                                            Width="10"
                                                            Height="10"
                                                            Margin="0,4,0,0"
                                                            VerticalAlignment="Top"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="5" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock FontSize="{StaticResource FontSizeXl}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   Text="{Binding Title}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   Text="{Binding InfoText}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   Text="{Binding Attachments.Count, StringFormat={}{0} Anhänge}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <Border x:Name="AttachmentDropZone"
                                        Grid.Column="1"
                                        Margin="0,12,12,12"
                                        Padding="16"
                                        Background="{DynamicResource RaisedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CardCornerRadius}"
                                        AllowDrop="True"
                                        AutomationProperties.Name="Anhangsbereich des ausgewählten Ereignisses"
                                        DragOver="AttachmentDropZone_DragOver"
                                        Drop="AttachmentDropZone_Drop"
                                        ToolTip="Eine oder mehrere lokale Dateien hier ablegen">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Foreground="{DynamicResource AccentTextBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   FontWeight="Bold"
                                                   Text="ANHÄNGE DES EREIGNISSES" />
                                        <StackPanel Grid.Row="1" Margin="0,7,0,12">
                                            <TextBlock FontSize="{StaticResource FontSizeXl}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       Text="{Binding SelectedEvent.Title, TargetNullValue='Ereignis auswählen'}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       Text="Dateien hier ablegen oder über die Schaltfläche auswählen. Mehrfachauswahl wird vollständig verarbeitet."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ListBox Grid.Row="2"
                                                 AutomationProperties.Name="Anhänge des ausgewählten Ereignisses"
                                                 ItemsSource="{Binding SelectedEvent.Attachments}"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6"
                                                            Padding="8"
                                                            Background="{DynamicResource SurfaceAltBrush}"
                                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       Text="{Binding OriginalFileName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <DockPanel Margin="0,3,0,0">
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                                           FontSize="{StaticResource FontSizeXs}"
                                                                           Text="{Binding State}" />
                                                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                                           FontSize="{StaticResource FontSizeXs}"
                                                                           Text="{Binding MediaType}" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding AddAttachmentsCommand}"
                                                    Content="Dateien hinzufügen" />
                                            <WrapPanel Margin="0,7,0,0">
                                                <Button Style="{StaticResource CompactButtonStyle}"
                                                        Command="{Binding PreviewImageCommand}"
                                                        Content="Bild" />
                                                <Button Style="{StaticResource CompactButtonStyle}"
                                                        Command="{Binding PreviewPdfCommand}"
                                                        Content="PDF" />
                                                <Button Style="{StaticResource CompactButtonStyle}"
                                                        Command="{Binding ShowAttachmentAnalysisCommand}"
                                                        Content="Analyse" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="2"
                Padding="14,8"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding ActiveFilterText}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding TimelineRangeText}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="SemiBold"
                           Text="{Binding TimelineZoomText, StringFormat=Zoom: {0}}" />
                <Button DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="10,3"
                        Command="{Binding CancelAttachmentImportCommand}"
                        Visibility="{Binding IsAttachmentImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Laufenden Datei- oder Analysevorgang abbrechen (Esc)"
                        Content="Vorgang abbrechen" />
                <ProgressBar DockPanel.Dock="Right"
                             Width="110"
                             Height="4"
                             Margin="18,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

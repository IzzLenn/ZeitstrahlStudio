<Window x:Class="ZeitstrahlStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeitstrahlStudio.App"
        Title="Zeitstrahl Studio"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        AutomationProperties.Name="Zeitstrahl Studio Hauptfenster"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FocusSearchCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.CreateContextCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteSelectionCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelAttachmentImportCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            </Style>

            <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            </Style>

            <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="4,4,10,4" />
                <Setter Property="Background" Value="{DynamicResource ToolbarSeparatorBrush}" />
            </Style>

            <Style x:Key="CommandGroupStyle" TargetType="Border">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="Background" Value="{DynamicResource CommandGroupBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            </Style>

            <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Setter Property="Content" Value="Navigation" />
                <Setter Property="ToolTip" Value="Linke Projektnavigation ein- oder ausblenden" />
            </Style>

            <Style x:Key="HorizontalOrientationButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TimelineViewOrientation}" Value="Horizontal">
                        <Setter Property="Foreground" Value="{DynamicResource NavigationSelectedForegroundBrush}" />
                        <Setter Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="VerticalOrientationButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TimelineViewOrientation}" Value="Vertical">
                        <Setter Property="Foreground" Value="{DynamicResource NavigationSelectedForegroundBrush}" />
                        <Setter Property="Background" Value="{DynamicResource NavigationSelectedBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menüleiste -->
        <Border Grid.Row="0"
                Background="{DynamicResource MenuBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Margin="14,0,14,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Width="24"
                            Height="24"
                            Margin="0,0,9,0"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="4">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource OnAccentTextBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="ZS" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource MenuForegroundBrush}"
                               FontWeight="SemiBold"
                               Text="Zeitstrahl Studio" />
                </StackPanel>

                <Menu x:Name="MainMenu"
                      AutomationProperties.Name="Hauptmenü">
                    <MenuItem Header="_Datei">
                        <MenuItem Header="_Neues Projekt" Command="{Binding NewProjectCommand}" InputGestureText="Strg+N" />
                        <MenuItem Header="Projekt _öffnen" Command="{Binding OpenProjectCommand}" />
                        <Separator />
                        <MenuItem Header="_Speichern" Command="{Binding SaveCommand}" InputGestureText="Strg+S" />
                        <MenuItem Header="Speichern _unter" Command="{Binding SaveAsCommand}" />
                        <MenuItem Header="_Duplizieren" Command="{Binding DuplicateCommand}" />
                        <Separator />
                        <MenuItem Header="Projekt s_chließen" Command="{Binding CloseProjectCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Bearbeiten">
                        <MenuItem Header="_Rückgängig" Command="{Binding UndoCommand}" InputGestureText="Strg+Z" />
                        <MenuItem Header="_Wiederholen" Command="{Binding RedoCommand}" InputGestureText="Strg+Y" />
                    </MenuItem>
                    <MenuItem Header="_Ansicht">
                        <MenuItem Header="_Horizontal" Command="{Binding SetHorizontalTimelineCommand}" />
                        <MenuItem Header="_Vertikal" Command="{Binding SetVerticalTimelineCommand}" />
                        <MenuItem Header="_Lücken komprimieren" Command="{Binding ToggleGapCompressionCommand}" />
                        <Separator />
                        <MenuItem Header="Gesamtprojekt anzeigen" Click="TimelineShowAll_Click" />
                        <MenuItem Header="Auswahl zentrieren" Click="TimelineCenterSelection_Click" />
                        <MenuItem Header="Timeline-Ansicht zurücksetzen" Click="TimelineResetView_Click" />
                        <Separator />
                        <MenuItem Header="_Navigation ein-/ausblenden" Click="SidebarToggle_Click" />
                        <MenuItem Header="_Details ein-/ausblenden" Click="InspectorToggle_Click" />
                        <MenuItem Header="Projekt_einstellungen" Command="{Binding SettingsCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Ereignis">
                        <MenuItem Header="_Hinzufügen" Command="{Binding AddEventCommand}" InputGestureText="Strg+N" />
                        <MenuItem Header="_Bearbeiten" Command="{Binding EditEventCommand}" />
                        <MenuItem Header="Nach _früher verschieben" Command="{Binding MoveEventEarlierCommand}" />
                        <MenuItem Header="Nach _später verschieben" Command="{Binding MoveEventLaterCommand}" />
                        <MenuItem Header="_Löschen" Command="{Binding DeleteEventCommand}" InputGestureText="Entf" />
                        <Separator />
                        <MenuItem Header="Anhänge hinzufügen" Command="{Binding AddAttachmentsCommand}" />
                        <MenuItem Header="Anhang öffnen" Command="{Binding OpenAttachmentCommand}" />
                        <MenuItem Header="Anhang entfernen" Command="{Binding RemoveAttachmentCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Werkzeuge">
                        <MenuItem Header="_Suchen" Click="SearchFocus_Click" InputGestureText="Strg+F" />
                        <MenuItem Header="Dokumente _analysieren" Command="{Binding AnalyzeAttachmentsCommand}" />
                        <MenuItem Header="Analyse anzeigen" Command="{Binding ShowAttachmentAnalysisCommand}" />
                        <MenuItem Header="Bildvorschau" Command="{Binding PreviewImageCommand}" />
                        <MenuItem Header="PDF-Vorschau" Command="{Binding PreviewPdfCommand}" />
                        <Separator />
                        <MenuItem Header="_Sicherungen" Command="{Binding ManageBackupsCommand}" />
                        <MenuItem Header="_Protokoll" Command="{Binding ShowAuditLogCommand}" />
                        <Separator />
                        <MenuItem Header="Als _PDF exportieren" Command="{Binding PdfExportCommand}" />
                        <MenuItem Header="Als _HTML exportieren" Command="{Binding HtmlExportCommand}" />
                    </MenuItem>
                    <MenuItem Header="_Hilfe">
                        <MenuItem Header="Info zu Zeitstrahl Studio" Click="About_Click" />
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- Globale Befehlsleiste -->
        <Border x:Name="GlobalCommandBar"
                Grid.Row="1"
                Padding="12,7"
                AutomationProperties.Name="Globale Befehlsleiste"
                Background="{DynamicResource CommandBarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding SettingsCommand}"
                        AutomationProperties.Name="Projekteinstellungen"
                        ToolTip="Projekteinstellungen öffnen"
                        Content="Einstellungen" />
                <Button x:Name="InspectorToggleButton"
                        DockPanel.Dock="Right"
                        Margin="0,0,7,0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="InspectorToggle_Click"
                        AutomationProperties.Name="Ereignisdetails umschalten"
                        ToolTip="Rechten Ereignisinspektor ein- oder ausblenden"
                        Content="Details" />

                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource CommandGroupStyle}">
                        <Button x:Name="SidebarToggleButton"
                                Style="{StaticResource SidebarToggleButtonStyle}"
                                Click="SidebarToggle_Click"
                                AutomationProperties.Name="Linke Navigation umschalten" />
                    </Border>
                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarPrimaryButtonStyle}"
                                    Command="{Binding NewProjectCommand}"
                                    AutomationProperties.Name="Neues Projekt"
                                    ToolTip="Neues Projekt erstellen"
                                    Content="Neu" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding OpenProjectCommand}"
                                    AutomationProperties.Name="Projekt öffnen"
                                    ToolTip="Vorhandenes Zeitstrahlprojekt öffnen"
                                    Content="Öffnen" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding SaveCommand}"
                                    AutomationProperties.Name="Projekt speichern"
                                    ToolTip="Projekt speichern (Strg+S)"
                                    Content="Speichern" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding UndoCommand}"
                                    ToolTip="Rückgängig (Strg+Z)"
                                    Content="Rückgängig" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding RedoCommand}"
                                    ToolTip="Wiederholen (Strg+Y)"
                                    Content="Wiederholen" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource HorizontalOrientationButtonStyle}"
                                    Command="{Binding SetHorizontalTimelineCommand}"
                                    AutomationProperties.Name="Horizontale Zeitstrahlansicht"
                                    ToolTip="Horizontalen Zeitstrahl anzeigen"
                                    Content="Horizontal" />
                            <Button Style="{StaticResource VerticalOrientationButtonStyle}"
                                    Command="{Binding SetVerticalTimelineCommand}"
                                    AutomationProperties.Name="Vertikale Zeitstrahlansicht"
                                    ToolTip="Vertikalen Zeitstrahl anzeigen"
                                    Content="Vertikal" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Click="SearchFocus_Click"
                                    AutomationProperties.Name="Projekt durchsuchen"
                                    ToolTip="Suche fokussieren (Strg+F)"
                                    Content="Suchen" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding AnalyzeAttachmentsCommand}"
                                    AutomationProperties.Name="Dokumente analysieren"
                                    ToolTip="Anhänge des ausgewählten Ereignisses lokal analysieren"
                                    Content="Analysieren" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CommandGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding PdfExportCommand}"
                                    AutomationProperties.Name="PDF exportieren"
                                    ToolTip="Zeitstrahl als PDF exportieren"
                                    Content="PDF" />
                            <Button Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding HtmlExportCommand}"
                                    AutomationProperties.Name="HTML exportieren"
                                    ToolTip="Zeitstrahl als eigenständige HTML-Datei exportieren"
                                    Content="HTML" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Hauptbereich -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="310" MinWidth="0" MaxWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" MinWidth="0" MaxWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Linke Projektnavigation -->
            <Border x:Name="SidebarPanel"
                    Grid.Column="0"
                    MinWidth="260"
                    Padding="16"
                    AutomationProperties.Name="Projekt- und Ereignisnavigation"
                    Background="{DynamicResource NavigationBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="AKTUELLES PROJEKT" />
                        <TextBlock Margin="0,7,0,0" FontSize="{StaticResource FontSize2Xl}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource NavigationForegroundBrush}" Text="{Binding ProjectName}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ProjectDescription}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{StaticResource FontSizeXs}" Text="{Binding ProjectArchivePath}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectArchivePath}" />
                    </StackPanel>
                    <Expander x:Name="SearchExpander" Grid.Row="1" Margin="0,18,0,10" IsExpanded="True"
                              Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Expander.Header>
                            <DockPanel Width="270">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionHeaderStyle}" Text="SUCHE UND FILTER" />
                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{StaticResource FontSizeXs}" Text="{Binding ActiveFilterText}" />
                            </DockPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <TextBox x:Name="SearchQueryTextBox" AutomationProperties.Name="Volltextsuche"
                                     ToolTip="Projektdaten, Ereignisse, Dateinamen, Links und extrahierte Dokumenttexte durchsuchen"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding ResetSearchFiltersCommand}" Content="Alle zurücksetzen" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{StaticResource FontSizeXs}" Text="{Binding SearchSummaryText}" />
                            </DockPanel>
                            <Expander Margin="0,9,0,0" IsExpanded="True" Header="Schnellfilter">
                                <StackPanel Margin="0,7,0,0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Priorität" />
                                    <ComboBox Margin="0,4,0,0" AutomationProperties.Name="Nach Priorität filtern"
                                              ItemsSource="{Binding SearchPriorityOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding SearchPriority}" />
                                    <TextBlock Margin="0,7,0,0" Style="{StaticResource LabelStyle}" Text="Schlagwort" />
                                    <ComboBox Margin="0,4,0,0" AutomationProperties.Name="Nach Schlagwort filtern"
                                              ItemsSource="{Binding SearchTagOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding SearchTag}" />
                                    <TextBlock Margin="0,7,0,0" Style="{StaticResource LabelStyle}" Text="Anhänge" />
                                    <ComboBox Margin="0,4,0,0" AutomationProperties.Name="Nach vorhandenen Anhängen filtern"
                                              ItemsSource="{Binding SearchAttachmentPresenceOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding SearchHasAttachment}" />
                                </StackPanel>
                            </Expander>
                            <Expander Margin="0,7,0,0" Header="Erweiterte Filter">
                                <StackPanel Margin="0,7,0,0">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Zeitraum" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DatePicker Grid.Column="0" AutomationProperties.Name="Suchzeitraum von"
                                                    SelectedDate="{Binding SearchFrom, UpdateSourceTrigger=PropertyChanged}" />
                                        <DatePicker Grid.Column="2" AutomationProperties.Name="Suchzeitraum bis"
                                                    SelectedDate="{Binding SearchUntil, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <TextBlock Margin="0,7,0,0" Style="{StaticResource LabelStyle}" Text="Datumsart" />
                                    <ComboBox Margin="0,4,0,0" AutomationProperties.Name="Datumsart filtern"
                                              ItemsSource="{Binding SearchPrecisionOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding SearchPrecision}" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" AutomationProperties.Name="Nach vorhandener Frist filtern"
                                                  ItemsSource="{Binding SearchDeadlinePresenceOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding SearchHasDeadline}" />
                                        <ComboBox Grid.Column="2" AutomationProperties.Name="Nach Friststatus filtern"
                                                  ItemsSource="{Binding SearchDeadlineStatusOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding SearchDeadlineStatus}" />
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" AutomationProperties.Name="Nach Farbe filtern"
                                                  ItemsSource="{Binding SearchColorOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding SearchColor}" />
                                        <ComboBox Grid.Column="2" AutomationProperties.Name="Nach Dateityp filtern"
                                                  ItemsSource="{Binding SearchMediaTypeOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding SearchMediaType}" />
                                    </Grid>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="7" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" AutomationProperties.Name="Nach vorhandenen PDF-Dateien filtern"
                                                  ItemsSource="{Binding SearchPdfPresenceOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding SearchHasPdf}" />
                                        <ComboBox Grid.Column="2" AutomationProperties.Name="Suchergebnisse sortieren"
                                                  ItemsSource="{Binding SearchSortOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding SearchSortMode}" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>
                    <Grid Grid.Row="2" Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionHeaderStyle}" Text="EREIGNISSE" />
                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{StaticResource FontSizeXs}" Text="{Binding SearchSummaryText}" />
                        </DockPanel>
                        <ListBox Grid.Row="1" AutomationProperties.Name="Suchergebnisse" ItemsSource="{Binding SearchResults}"
                                 Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="9" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="{StaticResource FontSizeXs}" Text="{Binding Date}" />
                                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Text="{Binding EventTitle}" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding Highlights}">
                                                <ItemsControl.ItemTemplate><DataTemplate><local:HighlightedTextBlock Margin="0,2,0,0"
                                                    Foreground="{DynamicResource SubtleTextBrush}" FontSize="{StaticResource FontSizeXs}"
                                                    HighlightedText="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <ScrollViewer Grid.Row="0" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasNoProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="PROJEKTE" />
                            <Grid Margin="0,10,0,10">
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontWeight="Bold" Text="ZULETZT VERWENDET" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource LinkButtonStyle}" Command="{Binding RefreshCommand}" Content="Aktualisieren" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="11" Background="{DynamicResource CardSurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}">
                                            <StackPanel>
                                                <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="{Binding ArchivePath}" Content="{Binding ProjectName}" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="{StaticResource FontSizeXs}"
                                                           Text="{Binding LastOpenedAtUtc, StringFormat='Zuletzt geöffnet: {0:g}'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,18,0,10" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" Text="WIEDERHERSTELLUNG" />
                            <ItemsControl ItemsSource="{Binding RecoveryCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="11" Background="{DynamicResource WarningLightBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProjectName}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,8" Foreground="{DynamicResource WarningTextBrush}" Text="Nicht ordnungsgemäß geschlossen" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,12,0" Style="{StaticResource LinkButtonStyle}"
                                                            Command="{Binding DataContext.RecoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Wiederherstellen" />
                                                    <Button Style="{StaticResource LinkButtonStyle}" Foreground="{DynamicResource DangerTextBrush}"
                                                            Command="{Binding DataContext.DiscardRecoveryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Verwerfen" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" />
            <!-- Hauptarbeitsbereich -->
            <Grid Grid.Column="2" Background="{DynamicResource WorkspaceBackgroundBrush}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="36">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="30"
                                   FontWeight="Light"
                                   Text="＋" />
                    </Border>
                    <TextBlock Margin="0,22,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSize4Xl}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="Eine Chronik beginnen" />
                    <TextBlock Width="470"
                               Margin="0,8,0,20"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="{StaticResource FontSizeLg}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Erstellen Sie ein lokales Projekt oder öffnen Sie ein vorhandenes .zeitprojekt-Archiv." />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NewProjectCommand}"
                                Content="Neues Projekt" />
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding OpenProjectCommand}"
                                Content="Projekt öffnen" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="24,20"
                      Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="{StaticResource FontSize3Xl}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{Binding ProjectName}" />
                    <DockPanel Grid.Row="1" Margin="0,9,0,18" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0,0,18,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Chronologische Ereignisübersicht" />
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding EventCount, StringFormat={}{0} Ereignisse}" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding DeleteEventCommand}"
                                ToolTip="Ausgewähltes Ereignis löschen (Entf)"
                                Content="Löschen" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding EditEventCommand}"
                                Content="Bearbeiten" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding MoveEventLaterCommand}"
                                ToolTip="Nur innerhalb identischer Datumsangaben"
                                Content="Später" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding MoveEventEarlierCommand}"
                                ToolTip="Nur innerhalb identischer Datumsangaben"
                                Content="Früher" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarPrimaryButtonStyle}"
                                Command="{Binding AddEventCommand}"
                                ToolTip="Neues Ereignis anlegen (Strg+N)"
                                Content="Hinzufügen" />
                    </DockPanel>
                    <TabControl Grid.Row="2"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                        <TabItem Header="Zeitstrahl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="9"
                                        Background="{DynamicResource RaisedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="False">
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding SetHorizontalTimelineCommand}"
                                                Content="Horizontal" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding SetVerticalTimelineCommand}"
                                                Content="Vertikal" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ToggleGapCompressionCommand}"
                                                ToolTip="Große leere Zeiträume komprimieren oder vollständig darstellen"
                                                Content="{Binding GapCompressionText}" />
                                        <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSeparatorStyle}" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineZoomOut_Click"
                                                ToolTip="Herauszoomen (Tastatur: Minus)"
                                                Content="−" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineZoomIn_Click"
                                                ToolTip="Hineinzoomen (Tastatur: Plus)"
                                                Content="+" />
                                        <TextBlock DockPanel.Dock="Left"
                                                   Width="58"
                                                   Margin="2,0,8,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="{Binding TimelineZoomText}" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineShowAll_Click"
                                                ToolTip="Gesamtes Projekt auf die Zeitachse einpassen"
                                                Content="Alles" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineCenterSelection_Click"
                                                ToolTip="Ausgewähltes Ereignis zentrieren"
                                                Content="Auswahl" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineResetView_Click"
                                                ToolTip="Zoom und sichtbaren Bereich zurücksetzen"
                                                Content="Zurücksetzen" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ResetTimelineLayoutCommand}"
                                                ToolTip="Alle manuellen Kartenpositionen entfernen und die automatische Anordnung wiederherstellen"
                                                Content="Auto-Layout" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Text="Mausrad: Zoom · Hintergrund ziehen: Verschieben" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1"
                                        Padding="9,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="Zeitraum anzeigen:" />
                                        <DatePicker Width="125"
                                                    AutomationProperties.Name="Anzuzeigender Zeitraum von"
                                                    SelectedDate="{Binding TimelineRangeStart, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="bis" />
                                        <DatePicker Width="125"
                                                    AutomationProperties.Name="Anzuzeigender Zeitraum bis"
                                                    SelectedDate="{Binding TimelineRangeEnd, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="9,0,0,0"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ShowTimelineRangeCommand}"
                                                ToolTip="Den gewählten fachlichen Zeitraum in den sichtbaren Ausschnitt einpassen"
                                                Content="Anzeigen" />
                                        <TextBlock Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   Text="Karte ziehen: nur Layout ändern · Datum bleibt unverändert" />
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="2"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True"
                                              Focusable="False">
                                    <local:TimelineView x:Name="TimelineControl"
                                                        AutomationProperties.Name="Interaktiver Zeitstrahl"
                                                        AutomationProperties.HelpText="Mit Plus und Minus zoomen, mit Pos1 das ganze Projekt anzeigen und Ereigniskarten mit den Pfeiltasten auswählen."
                                                        Project="{Binding CurrentProject}"
                                                        Workspace="{Binding ActiveWorkspace}"
                                                        ThumbnailService="{Binding TimelineThumbnailService}"
                                                        SelectedEvent="{Binding SelectedEvent, Mode=TwoWay}"
                                                        Orientation="{Binding TimelineViewOrientation}"
                                                        ZoomFactor="{Binding TimelineZoom, Mode=TwoWay}"
                                                        CompressLargeGaps="{Binding CompressLargeGaps}"
                                                        LayoutRevision="{Binding TimelineLayoutRevision}"
                                                        CardFontSize="{Binding TimelineCardFontSize}"
                                                        AxisFontSize="{Binding TimelineAxisFontSize}"
                                                        IsDarkTheme="{Binding IsDarkTheme}"
                                                        MoveCardCommand="{Binding MoveTimelineCardCommand}"
                                                        DropFilesCommand="{Binding ImportDroppedFilesCommand}"
                                                        RangeRequest="{Binding TimelineRangeRequest}"
                                                        VisibleEventIds="{Binding TimelineVisibleEventIds}"
                                                        CenterSelectionRevision="{Binding TimelineSelectionNavigationRevision}"
                                                        ToolTip="Ereigniskarte auswählen oder rein visuell ziehen; Hintergrund ziehen; Mausrad zoomt" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Ereignisliste">
                            <ListBox x:Name="EventList"
                                     Margin="12"
                                     AutomationProperties.Name="Chronologische Ereignisliste"
                                     ItemsSource="{Binding Events}"
                                     SelectedItem="{Binding SelectedEvent}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="EventList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="EventList_PreviewMouseMove"
                                     DragOver="EventList_DragOver"
                                     DragLeave="EventList_DragLeave"
                                     Drop="EventList_Drop"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ToolTip="Ereignis innerhalb derselben Datumsgruppe ziehen; Dateien auf das gewünschte Ereignis ablegen">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="Before"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="0,3,0,0" /></Trigger>
                                            <Trigger Property="Tag" Value="After"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="0,0,0,3" /></Trigger>
                                            <Trigger Property="Tag" Value="DropFiles"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Top" Foreground="{DynamicResource AccentTextBrush}"
                                                       FontSize="{StaticResource FontSizeLg}" FontWeight="Bold" Text="{Binding Date}" />
                                            <Border Grid.Column="1" Width="10" Height="10" Margin="0,4,0,0" VerticalAlignment="Top"
                                                    Background="{DynamicResource AccentBrush}" CornerRadius="5" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                                           Text="{Binding InfoText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}"
                                                           FontSize="{StaticResource FontSizeXs}" Text="{Binding Attachments.Count, StringFormat={}{0} Anhänge}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
            <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" Visibility="Collapsed" />
            <Border x:Name="InspectorPanel" Grid.Column="4" MinWidth="280" Padding="16"
                    AutomationProperties.Name="Detailinspektor"
                    Background="{DynamicResource InspectorBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                                Click="InspectorToggle_Click" AutomationProperties.Name="Details ausblenden"
                                ToolTip="Detailinspektor ausblenden" Content="Schließen" />
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="DETAILS" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,15,0,12"
                                Visibility="{Binding HasSelectedEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="{StaticResource FontSizeSm}"
                                   Text="{Binding SelectedEventDateText}" />
                        <TextBlock Margin="0,5,0,0" FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedEvent.Title}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" Text="Wählen Sie ein Ereignis aus, um seine Details anzuzeigen."
                               Visibility="{Binding HasNoSelectedEvent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TabControl Grid.Row="2" Visibility="{Binding HasSelectedEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabItem Header="Allgemein">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="4,12,4,4">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Beschreibung" />
                                    <TextBlock Margin="0,5,0,12" Padding="9" MinHeight="64" TextWrapping="Wrap"
                                               Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding SelectedEventDescriptionText}" />
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Priorität" />
                                    <TextBlock Margin="0,5,0,12" Text="{Binding SelectedEventPriorityText}" />
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Status" />
                                    <TextBlock Margin="0,5,0,12" Text="{Binding SelectedEventStatusText}" />
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Schlagwörter" />
                                    <TextBlock Margin="0,5,0,12" Text="{Binding SelectedEventTagsText}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Frist" />
                                    <TextBlock Margin="0,5,0,12" Text="{Binding SelectedEventDeadlineText}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Zusatzinformation" />
                                    <TextBlock Margin="0,5,0,12" Text="{Binding SelectedEventInfoText}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{StaticResource FontSizeXs}"
                                               Text="{Binding SelectedEventAuditText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Anhänge">
                            <Border x:Name="AttachmentDropZone" Margin="4,12,4,4" Padding="10"
                                    AutomationProperties.Name="Anhangsbereich des ausgewählten Ereignisses"
                                    AllowDrop="True" DragOver="AttachmentDropZone_DragOver" Drop="AttachmentDropZone_Drop"
                                    Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource CardCornerRadius}"
                                    ToolTip="Eine oder mehrere lokale Dateien hier ablegen">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{StaticResource FontSizeXs}"
                                               Text="Dateien hier ablegen oder auswählen." />
                                    <ListBox Grid.Row="1" Margin="0,9" AutomationProperties.Name="Anhänge des ausgewählten Ereignisses"
                                             ItemsSource="{Binding SelectedEvent.Attachments}" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,6" Padding="8" Background="{DynamicResource SurfaceAltBrush}"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding OriginalFileName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}" Text="{Binding MediaType}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="2">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddAttachmentsCommand}" Content="Dateien hinzufügen" />
                                        <WrapPanel Margin="0,7,0,0">
                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding OpenAttachmentCommand}" Content="Öffnen" />
                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding PreviewImageCommand}" Content="Bild" />
                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding PreviewPdfCommand}" Content="PDF" />
                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding ShowAttachmentAnalysisCommand}" Content="Analyse" />
                                            <Button Style="{StaticResource CompactButtonStyle}" Command="{Binding RemoveAttachmentCommand}" Content="Entfernen" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem Header="Notizen">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Margin="8,12" Padding="9" MinHeight="96" TextWrapping="Wrap"
                                           Background="{DynamicResource InputBackgroundBrush}" Text="{Binding SelectedEventNotesText}" />
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal"
                                Visibility="{Binding HasSelectedEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Margin="0,0,7,0" Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding EditEventCommand}" Content="Bearbeiten" />
                        <Button Style="{StaticResource BaseButtonStyle}" Command="{Binding DeleteEventCommand}" Content="Löschen" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="3"
                Padding="14,8"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding ActiveFilterText}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding TimelineRangeText}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="SemiBold"
                           Text="{Binding TimelineZoomText, StringFormat=Zoom: {0}}" />
                <Button DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="10,3"
                        Command="{Binding CancelAttachmentImportCommand}"
                        Visibility="{Binding IsAttachmentImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="Laufenden Datei- oder Analysevorgang abbrechen (Esc)"
                        Content="Vorgang abbrechen" />
                <ProgressBar DockPanel.Dock="Right"
                             Width="110"
                             Height="4"
                             Margin="18,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="ZeitstrahlStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeitstrahlStudio.App"
        Title="Zeitstrahl Studio"
        Width="1280"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        FontFamily="Segoe UI"
        Background="#F1F5F9">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
        </Style>
        <Style x:Key="CompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,12" Background="#0F172A">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Margin="0,0,28,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Text="Zeitstrahl Studio" />
                    <TextBlock Foreground="#94A3B8" FontSize="11" Text="Lokale Projektchroniken" />
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewProjectCommand}" Content="Neu" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenProjectCommand}" Content="Öffnen" />
                <Border DockPanel.Dock="Left" Width="1" Margin="4,2,12,2" Background="#475569" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SaveCommand}" Content="Speichern" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SaveAsCommand}" Content="Speichern unter" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DuplicateCommand}" Content="Duplizieren" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CloseProjectCommand}" Content="Schließen" />
                <Border DockPanel.Dock="Left" Width="1" Margin="4,2,12,2" Background="#475569" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UndoCommand}" Content="Rückgängig" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RedoCommand}" Content="Wiederholen" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Click="SearchFocus_Click" Content="Suchen" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ShowAuditLogCommand}" Content="Protokoll" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ManageBackupsCommand}" Content="Sicherungen" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SetHorizontalTimelineCommand}" Content="Horizontal" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SetVerticalTimelineCommand}" Content="Vertikal" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddAttachmentsCommand}" Content="Dateien +" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AnalyzeAttachmentsCommand}" Content="Analysieren" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ShowAttachmentAnalysisCommand}" Content="Analyse anzeigen" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PreviewImageCommand}" Content="Bildvorschau" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PreviewPdfCommand}" Content="PDF-Vorschau" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PdfExportCommand}" Content="PDF-Export" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding HtmlExportCommand}" Content="HTML-Export" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenAttachmentCommand}" Content="Öffnen" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RemoveAttachmentCommand}" Content="Datei entfernen" />
                </DockPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="20"
                    Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Foreground="#64748B" FontSize="11" FontWeight="Bold" Text="AKTUELLES PROJEKT" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProjectName}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#475569"
                                   Text="{Binding ProjectDescription}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   Text="{Binding ProjectArchivePath}"
                                   TextWrapping="Wrap" />

                        <Expander x:Name="SearchExpander"
                                  Margin="0,22,0,0"
                                  IsExpanded="True"
                                  IsEnabled="{Binding HasProject}">
                            <Expander.Header>
                                <DockPanel Width="270">
                                    <TextBlock DockPanel.Dock="Left"
                                               Foreground="#1D4ED8"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Text="SUCHE UND FILTER" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               Text="{Binding ActiveFilterText}" />
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,10,0,0">
                                <TextBox x:Name="SearchQueryTextBox"
                                         Padding="8,6"
                                         ToolTip="Projektdaten, Ereignisse, Dateinamen, Links und extrahierte Dokumenttexte durchsuchen"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0"
                                                ToolTip="Zeitraum ab"
                                                SelectedDate="{Binding SearchFrom, UpdateSourceTrigger=PropertyChanged}" />
                                    <DatePicker Grid.Column="2"
                                                ToolTip="Zeitraum bis"
                                                SelectedDate="{Binding SearchUntil, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <ComboBox Margin="0,7,0,0"
                                          ItemsSource="{Binding SearchPrecisionOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SearchPrecision}" />
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding SearchDeadlinePresenceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchHasDeadline}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding SearchDeadlineStatusOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchDeadlineStatus}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding SearchPriorityOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchPriority}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding SearchColorOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchColor}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding SearchTagOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchTag}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding SearchMediaTypeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchMediaType}" />
                                </Grid>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="7" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding SearchAttachmentPresenceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchHasAttachment}" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding SearchPdfPresenceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchHasPdf}" />
                                </Grid>
                                <DockPanel Margin="0,8,0,6">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Command="{Binding ResetSearchFiltersCommand}"
                                            Content="Alle zurücksetzen" />
                                    <ComboBox Width="105"
                                              DockPanel.Dock="Left"
                                              ItemsSource="{Binding SearchSortOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SearchSortMode}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B"
                                               FontSize="11"
                                               Text="{Binding SearchSummaryText}" />
                                </DockPanel>
                                <ListBox Height="330"
                                         ItemsSource="{Binding SearchResults}"
                                         Background="#FFFFFF"
                                         BorderBrush="#E2E8F0"
                                         BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Padding="9"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="#64748B"
                                                                   FontSize="10"
                                                                   Text="{Binding Date}" />
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding EventTitle}"
                                                                   TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Highlights}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <local:HighlightedTextBlock Margin="0,2,0,0"
                                                                                            Foreground="#475569"
                                                                                            FontSize="10"
                                                                                            HighlightedText="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Expander>

                        <Grid Margin="0,28,0,10">
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Text="ZULETZT VERWENDET" />
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    Content="Aktualisieren" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="11"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <StackPanel>
                                            <Button Style="{StaticResource LinkButtonStyle}"
                                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding ArchivePath}"
                                                    Content="{Binding ProjectName}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="#64748B"
                                                       FontSize="11"
                                                       Text="{Binding LastOpenedAtUtc, StringFormat='Zuletzt geöffnet: {0:g}'}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,22,0,0">
                            <TextBlock Margin="0,0,0,10"
                                       Foreground="#B45309"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Text="WIEDERHERSTELLUNG" />
                            <ItemsControl ItemsSource="{Binding RecoveryCandidates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="11"
                                                Background="#FFFBEB"
                                                BorderBrush="#FCD34D"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ProjectName}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,8"
                                                           Foreground="#92400E"
                                                           FontSize="11"
                                                           Text="Nicht ordnungsgemäß geschlossen" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Margin="0,0,12,0"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            Command="{Binding DataContext.RecoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Wiederherstellen" />
                                                    <Button Style="{StaticResource LinkButtonStyle}"
                                                            Foreground="#B91C1C"
                                                            Command="{Binding DataContext.DiscardRecoveryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Verwerfen" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Background="#FFFFFF">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Width="72" Height="72" HorizontalAlignment="Center" Background="#DBEAFE" CornerRadius="36">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#1D4ED8"
                                   FontSize="30"
                                   FontWeight="Light"
                                   Text="＋" />
                    </Border>
                    <TextBlock Margin="0,22,0,0"
                               HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Text="Eine Chronik beginnen" />
                    <TextBlock Width="470"
                               Margin="0,8,0,20"
                               Foreground="#64748B"
                               FontSize="14"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="Erstellen Sie ein lokales Projekt oder öffnen Sie ein vorhandenes .zeitprojekt-Archiv." />
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewProjectCommand}" Content="Neues Projekt" />
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenProjectCommand}" Content="Projekt öffnen" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="34,28"
                      Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding ProjectName}" />
                    <DockPanel Grid.Row="1" Margin="0,9,0,22" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Margin="0,0,18,0"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"
                                   Text="Chronologische Ereignisübersicht" />
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#475569"
                                   FontWeight="SemiBold"
                                   Text="{Binding EventCount, StringFormat={}{0} Ereignisse}" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding DeleteEventCommand}"
                                Content="Löschen" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding EditEventCommand}"
                                Content="Bearbeiten" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding MoveEventLaterCommand}"
                                ToolTip="Nur innerhalb identischer Datumsangaben"
                                Content="Später" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CompactButtonStyle}"
                                Command="{Binding MoveEventEarlierCommand}"
                                ToolTip="Nur innerhalb identischer Datumsangaben"
                                Content="Früher" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddEventCommand}"
                                Content="Hinzufügen" />
                    </DockPanel>
                    <TabControl Grid.Row="2"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1">
                        <TabItem Header="Zeitstrahl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="9"
                                        Background="#FFFFFF"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1">
                                    <DockPanel LastChildFill="False">
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding SetHorizontalTimelineCommand}"
                                                Content="Horizontal" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding SetVerticalTimelineCommand}"
                                                Content="Vertikal" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ToggleGapCompressionCommand}"
                                                ToolTip="Große leere Zeiträume komprimieren oder vollständig darstellen"
                                                Content="{Binding GapCompressionText}" />
                                        <Border DockPanel.Dock="Left" Width="1" Margin="6,3,11,3" Background="#CBD5E1" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineZoomOut_Click"
                                                ToolTip="Herauszoomen (Tastatur: Minus)"
                                                Content="−" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineZoomIn_Click"
                                                ToolTip="Hineinzoomen (Tastatur: Plus)"
                                                Content="+" />
                                        <TextBlock DockPanel.Dock="Left"
                                                   Width="58"
                                                   Margin="2,0,8,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding TimelineZoomText}" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineShowAll_Click"
                                                ToolTip="Gesamtes Projekt auf die Zeitachse einpassen"
                                                Content="Alles" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineCenterSelection_Click"
                                                ToolTip="Ausgewähltes Ereignis zentrieren"
                                                Content="Auswahl" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Click="TimelineResetView_Click"
                                                ToolTip="Zoom und sichtbaren Bereich zurücksetzen"
                                                Content="Zurücksetzen" />
                                        <Button DockPanel.Dock="Left"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ResetTimelineLayoutCommand}"
                                                ToolTip="Alle manuellen Kartenpositionen entfernen und die automatische Anordnung wiederherstellen"
                                                Content="Auto-Layout" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   Text="Mausrad: Zoom · Hintergrund ziehen: Verschieben" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1"
                                        Padding="9,6"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="Zeitraum anzeigen:" />
                                        <DatePicker Width="125"
                                                    SelectedDate="{Binding TimelineRangeStart, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   Text="bis" />
                                        <DatePicker Width="125"
                                                    SelectedDate="{Binding TimelineRangeEnd, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="9,0,0,0"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Command="{Binding ShowTimelineRangeCommand}"
                                                ToolTip="Den gewählten fachlichen Zeitraum in den sichtbaren Ausschnitt einpassen"
                                                Content="Anzeigen" />
                                        <TextBlock Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   Text="Karte ziehen: nur Layout ändern · Datum bleibt unverändert" />
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="2"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True"
                                              Focusable="False">
                                    <local:TimelineView x:Name="TimelineControl"
                                                        Project="{Binding CurrentProject}"
                                                        SelectedEvent="{Binding SelectedEvent, Mode=TwoWay}"
                                                        Orientation="{Binding TimelineViewOrientation}"
                                                        ZoomFactor="{Binding TimelineZoom, Mode=TwoWay}"
                                                        CompressLargeGaps="{Binding CompressLargeGaps}"
                                                        LayoutRevision="{Binding TimelineLayoutRevision}"
                                                        MoveCardCommand="{Binding MoveTimelineCardCommand}"
                                                        RangeRequest="{Binding TimelineRangeRequest}"
                                                        VisibleEventIds="{Binding TimelineVisibleEventIds}"
                                                        CenterSelectionRevision="{Binding TimelineSelectionNavigationRevision}"
                                                        ToolTip="Ereigniskarte auswählen oder rein visuell ziehen; Hintergrund ziehen; Mausrad zoomt" />
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Ereignisliste">
                            <Border Background="#F8FAFC"
                                    CornerRadius="6">
                        <ListBox Margin="12"
                                 ItemsSource="{Binding Events}"
                                 SelectedItem="{Binding SelectedEvent}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Top"
                                                       Foreground="#1D4ED8"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Text="{Binding Date}" />
                                            <Border Grid.Column="1"
                                                    Width="10"
                                                    Height="10"
                                                    Margin="0,4,0,0"
                                                    VerticalAlignment="Top"
                                                    Background="#3B82F6"
                                                    CornerRadius="5" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="#64748B"
                                                           Text="{Binding InfoText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="#475569"
                                                           FontSize="11"
                                                           Text="{Binding Attachments.Count, StringFormat={}{0} Anhänge}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="14,8"
                Background="#E2E8F0"
                BorderBrush="#CBD5E1"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#334155"
                           Text="{Binding ActiveFilterText}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#334155"
                           Text="{Binding TimelineRangeText}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#334155"
                           FontWeight="SemiBold"
                           Text="{Binding TimelineZoomText, StringFormat=Zoom: {0}}" />
                <Button DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="10,3"
                        Command="{Binding CancelAttachmentImportCommand}"
                        Visibility="{Binding IsAttachmentImporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Content="Vorgang abbrechen" />
                <ProgressBar DockPanel.Dock="Right"
                             Width="110"
                             Height="4"
                             Margin="18,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock VerticalAlignment="Center" Foreground="#334155" Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hintergründe -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111827" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#334155" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#1E293B" />

    <!-- Semantische Oberflächen -->
    <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="NavigationForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="NavigationSelectedBackgroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="NavigationSelectedForegroundBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="CommandBarBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CommandGroupBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="InspectorBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ReadOnlyBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="ReadOnlyForegroundBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#334155" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="InvalidBackgroundBrush" Color="#450A0A" />
    <SolidColorBrush x:Key="InvalidBorderBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#0F172A" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnDangerTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnWarningTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="OnSuccessTextBrush" Color="#FFFFFF" />

    <!-- Akzent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8" />

    <!-- Rahmen -->
    <SolidColorBrush x:Key="BorderBrush" Color="#475569" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#64748B" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="DividerBrush" Color="#334155" />

    <!-- Header -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#020617" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="ToolbarSeparatorBrush" Color="#475569" />

    <!-- Zustände -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#334155" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#64748B" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#475569" />

    <!-- Semantische Farben -->
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#450A0A" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FCA5A5" />

    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningDarkBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="#451A03" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FCD34D" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#052E16" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#86EFAC" />

    <SolidColorBrush x:Key="InfoBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="InfoLightBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#93C5FD" />

    <!-- Zeitstrahl -->
    <SolidColorBrush x:Key="TimelineBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TimelineAxisBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TimelineCardBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="TimelineCardBorderBrush" Color="#475569" />
    <SolidColorBrush x:Key="TimelineSelectedBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="TimelineDeadlineBrush" Color="#F87171" />
    <SolidColorBrush x:Key="TimelineConnectorBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TimelineThumbnailPlaceholderBrush" Color="#334155" />
    <SolidColorBrush x:Key="TimelineEmptyTextBrush" Color="#CBD5E1" />

    <!-- Schatten/Overlay -->
    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="DropShadowBrush" Color="#000000" />

    <!-- Konstanten -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">8</CornerRadius>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>

</ResourceDictionary>

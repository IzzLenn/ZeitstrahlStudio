<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Hintergründe -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F8FAFC" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#334155" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#475569" />
    <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnDangerTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnWarningTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="OnSuccessTextBrush" Color="#FFFFFF" />

    <!-- Akzent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />

    <!-- Rahmen -->
    <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" />

    <!-- Header -->
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="ToolbarSeparatorBrush" Color="#475569" />

    <!-- Zustände -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="SelectedBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#CBD5E1" />

    <!-- Semantische Farben -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#991B1B" />

    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningDarkBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarningLightBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#92400E" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534" />

    <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="InfoLightBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#1E40AF" />

    <!-- Zeitstrahl -->
    <SolidColorBrush x:Key="TimelineBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TimelineAxisBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TimelineCardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TimelineCardBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TimelineSelectedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="TimelineDeadlineBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="TimelineConnectorBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TimelineThumbnailPlaceholderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TimelineEmptyTextBrush" Color="#64748B" />

    <!-- Schatten/Overlay -->
    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#990F172A" />
    <SolidColorBrush x:Key="DropShadowBrush" Color="#0F172A" />

    <!-- Konstanten -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">8</CornerRadius>
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>

</ResourceDictionary>

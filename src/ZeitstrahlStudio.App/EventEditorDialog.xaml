<Window x:Class="ZeitstrahlStudio.App.EventEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeitstrahlStudio.App"
        Title="{Binding DialogTitle}"
        Width="900"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FormLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <local:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,14"
                Background="{DynamicResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                           FontSize="{StaticResource FontSize2Xl}"
                           FontWeight="SemiBold"
                           Text="{Binding DialogTitle}" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="Datumsangaben, Inhalt und Einordnung werden lokal im Projekt gespeichert." />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="18">
            <TabItem Header="Inhalt und Datum">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Titel *" />
                            <TextBox MaxLength="500"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <GroupBox Grid.Row="1" Margin="0,18,0,0" Padding="14" Header="Datumsangabe">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FormLabelStyle}" Text="Genauigkeit" />
                                <ComboBox Width="240"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding DatePrecisionOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedPrecision}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Jahr *" />
                                        <TextBox MaxLength="4" Text="{Binding StartYear}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" IsEnabled="{Binding NeedsMonth}">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Monat" />
                                        <TextBox MaxLength="2" Text="{Binding StartMonth}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0" IsEnabled="{Binding NeedsDay}">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Tag" />
                                        <TextBox MaxLength="2" Text="{Binding StartDay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" IsEnabled="{Binding NeedsTime}">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Uhrzeit (HH:mm)" />
                                        <TextBox MaxLength="8" Text="{Binding StartTime}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0" IsEnabled="{Binding NeedsEndDate}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Endjahr" />
                                        <TextBox MaxLength="4" Text="{Binding EndYear}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Endmonat" />
                                        <TextBox MaxLength="2" Text="{Binding EndMonth}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Endtag" />
                                        <TextBox MaxLength="2" Text="{Binding EndDay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3"
                                               Margin="8,22,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="Nur bei der Genauigkeit „Zeitraum“ erforderlich." />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Kurzinfo" />
                            <TextBox Text="{Binding InfoText}"
                                     AcceptsReturn="True"
                                     MinHeight="58"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Ausführliche Beschreibung" />
                            <TextBox Text="{Binding Description}"
                                     AcceptsReturn="True"
                                     MinHeight="110"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Quelle" />
                            <TextBox Text="{Binding Source}" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Interne Notizen" />
                            <TextBox Text="{Binding Notes}"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <TextBlock Grid.Row="6"
                                   Margin="0,14,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="* Pflichtfeld"
                                   FontSize="{StaticResource FontSizeSm}" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Frist, Einordnung und Links">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Padding="14" Header="Unabhängige Frist">
                            <StackPanel>
                                <CheckBox Margin="0,0,0,14"
                                          FontWeight="SemiBold"
                                          IsChecked="{Binding HasDeadline}"
                                          Content="Für dieses Ereignis eine Frist führen" />
                                <Grid IsEnabled="{Binding HasDeadline}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="145" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Fälligkeitsdatum" />
                                        <DatePicker x:Name="DeadlineDatePicker"
                                                    AutomationProperties.Name="Fälligkeitsdatum"
                                                    SelectedDate="{Binding DeadlineDate}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Uhrzeit (optional)" />
                                        <TextBox Text="{Binding DeadlineTime}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Status" />
                                        <ComboBox ItemsSource="{Binding DeadlineStatusOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedDeadlineStatus}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Bezeichnung" />
                                        <TextBox Text="{Binding DeadlineLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,13,0,0">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Erinnerungsnotiz" />
                                        <TextBox MinHeight="55"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding ReminderNote}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Margin="0,18,0,0" Padding="14" Header="Einordnung">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Priorität" />
                                    <ComboBox ItemsSource="{Binding PriorityOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedPriority}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Status" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedStatus}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,16,0,0">
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Farbe" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34"
                                                Height="34"
                                                AutomationProperties.Name="Vorschau der Ereignisfarbe"
                                                Background="{Binding ColorHex, Converter={StaticResource HexColorBrushConverter}}"
                                                BorderBrush="{DynamicResource StrongBorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="4" />
                                        <TextBox Grid.Column="2"
                                                 MaxLength="7"
                                                 AutomationProperties.Name="Ereignisfarbe als Hexwert"
                                                 ToolTip="Eigene Farbe im Format #RRGGBB eingeben"
                                                 Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="Eigener Wert: #RRGGBB"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <ListBox x:Name="EventColorPalette"
                                             Margin="0,10,0,0"
                                             Padding="0"
                                             AutomationProperties.Name="Visuelle Ereignisfarbauswahl"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding ColorOptions}"
                                             SelectedValuePath="Hex"
                                             SelectedValue="{Binding SelectedPaletteColorHex, Mode=TwoWay}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Margin" Value="0,0,7,7" />
                                                <Setter Property="Padding" Value="4" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="34"
                                                        Height="34"
                                                        AutomationProperties.Name="{Binding Label, StringFormat=Ereignisfarbe {0}}"
                                                        Background="{Binding Hex}"
                                                        BorderBrush="{DynamicResource StrongBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ToolTip="{Binding Label}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Schlagwörter" />
                            <TextBox Text="{Binding TagsText}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Text="Mehrere Schlagwörter mit Komma oder Semikolon trennen." />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Webseitenlinks" />
                            <TextBox MinHeight="125"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Text="{Binding WebLinksText}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{StaticResource FontSizeSm}"
                                       Text="Ein Link pro Zeile: Bezeichnung | https://adresse.example – die Bezeichnung ist optional." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="18,12"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource BaseButtonStyle}"
                        Width="100"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Content="Abbrechen" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Width="115"
                        IsDefault="True"
                        Click="Confirm_Click"
                        Content="Übernehmen" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

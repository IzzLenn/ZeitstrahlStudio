<Window x:Class="ZeitstrahlStudio.App.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neues Projekt"
        Width="440" Height="210"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Neues Zeitstrahlprojekt" />
        <TextBlock Grid.Row="1" Margin="0,16,0,6" Text="Projektname" />
        <TextBox x:Name="ProjectNameTextBox"
                 Grid.Row="2"
                 Height="32"
                 VerticalAlignment="Top"
                 MaxLength="200"
                 Text="Neues Projekt" />
        <StackPanel Grid.Row="3" Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="90" Margin="0,0,8,0" IsCancel="True" Content="Abbrechen" />
            <Button Width="90" IsDefault="True" Click="Confirm_Click" Content="Erstellen" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="ZeitstrahlStudio.App.HtmlExportOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Standalone-HTML-Export"
        Width="520"
        Height="420"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,15" Background="{DynamicResource HeaderBackgroundBrush}">
            <StackPanel>
                <TextBlock Foreground="{DynamicResource HeaderForegroundBrush}"
                           FontSize="{StaticResource FontSize2Xl}"
                           FontWeight="SemiBold"
                           Text="Standalone-HTML exportieren" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource HeaderMutedBrush}"
                           Text="Eine einzelne responsive Datei ohne Server oder externe Ressourcen." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,18">
            <TextBlock Style="{StaticResource LabelStyle}" Text="Anfangsdarstellung" />
            <ComboBox x:Name="OrientationBox"
                      Margin="0,6,0,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="Horizontaler Zeitstrahl" />
                <ComboBoxItem Content="Vertikaler Zeitstrahl" />
            </ComboBox>

            <CheckBox x:Name="IncludeThumbnailsBox"
                      Margin="0,18,0,0"
                      IsChecked="True"
                      Content="Kleine Dokumentvorschauen einbetten" />
            <TextBlock Margin="22,4,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="{StaticResource FontSizeXs}"
                       Text="Primäre PDF-Seiten und Bilder werden verkleinert direkt in die HTML-Datei aufgenommen."
                       TextWrapping="Wrap" />

            <CheckBox x:Name="IncludeNotesBox"
                      Margin="0,14,0,0"
                      Content="Interne Notizen in die Momentaufnahme aufnehmen" />

            <Border Margin="0,18,0,0"
                    Padding="11"
                    Background="{DynamicResource WarningLightBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource ControlCornerRadius}">
                <TextBlock Foreground="{DynamicResource WarningTextBrush}"
                           Text="Die HTML-Datei enthält eine unveränderliche Momentaufnahme. Webseitenlinks sind als externe Ziele gekennzeichnet und fragen vor dem Öffnen nach."
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Padding="16,12" Background="{DynamicResource SurfaceAltBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="96"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Abbrechen" />
                <Button Width="110"
                        IsDefault="True"
                        Click="Confirm_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Weiter …" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

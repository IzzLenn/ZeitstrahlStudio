<Window x:Class="ZeitstrahlStudio.App.AttachmentSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anhang auswählen"
        Width="560"
        Height="410"
        MinWidth="460"
        MinHeight="330"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource HeadingStyle}" />
            <TextBlock x:Name="HelpText"
                       Margin="0,5,0,14"
                       Style="{StaticResource BodyStyle}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="AttachmentList"
                 Grid.Row="1"
                 ItemsSource="{Binding}"
                 DisplayMemberPath="OriginalFileName"
                 SelectionMode="Single"
                 MouseDoubleClick="AttachmentList_MouseDoubleClick" />
        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="95" Margin="0,0,8,0" IsCancel="True" Content="Abbrechen" />
            <Button x:Name="ConfirmButton"
                    MinWidth="105"
                    IsDefault="True"
                    Click="Confirm_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>

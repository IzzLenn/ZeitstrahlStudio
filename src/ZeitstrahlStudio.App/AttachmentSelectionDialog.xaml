<Window x:Class="ZeitstrahlStudio.App.AttachmentSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anhang entfernen"
        Width="560"
        Height="410"
        MinWidth="460"
        MinHeight="330"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="21" FontWeight="SemiBold" Text="Anhangszuordnung entfernen" />
            <TextBlock Margin="0,5,0,14"
                       Foreground="#64748B"
                       Text="Die Projektkopie bleibt für Undo erhalten." />
        </StackPanel>
        <ListBox x:Name="AttachmentList"
                 Grid.Row="1"
                 ItemsSource="{Binding}"
                 DisplayMemberPath="OriginalFileName"
                 SelectionMode="Single"
                 MouseDoubleClick="AttachmentList_MouseDoubleClick" />
        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="95" Height="32" Margin="0,0,8,0" IsCancel="True" Content="Abbrechen" />
            <Button Width="105"
                    Height="32"
                    IsDefault="True"
                    Click="Confirm_Click"
                    Background="#B91C1C"
                    Foreground="#FFFFFF"
                    Content="Entfernen" />
        </StackPanel>
    </Grid>
</Window>
